FROM python:3.12-slim

# Copy uv binaries from the official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy dependency files first to leverage Docker layer caching
COPY pyproject.toml uv.lock .python-version ./

# Sync dependencies. --frozen is preferred over --locked for CI/Docker builds
# as it ensures uv won't attempt to update the lockfile.
RUN uv sync --frozen

# Ensure the virtual environment's binaries are preferred in the PATH
ENV PATH="/app/.venv/bin:$PATH"

# Copy the rest of the application code
COPY . .

# Run streamlit using the explicit virtual environment path to prevent execution issues
CMD ["/app/.venv/bin/streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]